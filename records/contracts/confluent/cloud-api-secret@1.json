      "statement": "total-length: 64 characters: cflt plus 60",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-24",
      "sources": [
        {
          "sourceId": "docs-confluent-io-4bc13cfee0",
          "supports": "total-length: 64 characters: cflt plus 60"
        }
      ]
    },
    {
      "id": "field-alphabet",
      "statement": "alphabet: [A-Za-z0-9+/] after the prefix",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-24",
      "sources": [
        {
          "sourceId": "docs-confluent-io-4bc13cfee0",
          "supports": "\"A-Z, a-z, 0-9, + or /\""
        }
      ]
    },
    {
      "id": "field-checksum",
      "statement": "checksum: the final 6 characters are a Base64-encoded CRC32 of the 54 characters before them",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-24",
      "sources": [
        {
          "sourceId": "docs-confluent-io-4bc13cfee0",
          "supports": "checksum: the final 6 characters are a Base64-encoded CRC32 of the 54 characters before them"
        }
      ]
    },
    {
      "id": "field-checksum-algorithm",
      "statement": "checksum-algorithm: CRC32 over the 54 body characters after cflt (prefix excluded), 4 bytes little-endian, standard Base64, first 6 characters (Published as code on the provider's documentation page, so it is recorded as provider code, not prose. Corrects the earlier claim that the checksum could not be recomputed.)",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-24",
      "sources": [
        {
          "sourceId": "docs-confluent-io-4bc13cfee0",
          "supports": "the page's own secret-detection snippet"
        },
        {
          "sourceId": "github-com-redact-secret-redact-secret-benchmarks-141feacce3",
          "supports": "the page's example validates little-endian and fails big-endian or prefix-included"
        }
      ]
    },
    {
      "id": "field-final-character",
      "statement": "final-character: one of A, Q, g, w (6 Base64 characters carry 36 bits for 32 CRC bits) (Derived from the published algorithm; not separately fixtured.)",
      "evidenceClass": "unresolved",
      "temporality": "current",
      "observedAt": "2026-09-24",
      "sources": [
        {
          "sourceId": "github-com-redact-secret-redact-secret-benchmarks-141feacce3",
          "supports": "final-character: one of A, Q, g, w (6 Base64 characters carry 36 bits for 32 CRC bits)"
        }
      ]
    },
    {
      "id": "field-generation-boundary",
      "statement": "generation-boundary: cflt secrets are those created after (or on and after) 2025-07-30 (Wording drift between the two pages; a drift note, not a blocker.)",
      "evidenceClass": "unresolved",
      "temporality": "current",
      "observedAt": "2026-09-24",
      "sources": [
        {
