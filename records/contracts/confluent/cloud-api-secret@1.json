        },
        {
          "sourceId": "docs-confluent-io-7ee9c532d3",
          "supports": "\"on or after July 30, 2025\""
        }
      ]
    },
    {
      "id": "field-key-id",
      "statement": "key-id: the 16-character API key ID is \"not considered secret information\" (Backs the public-id controls.)",
      "evidenceClass": "provider-documented",
      "temporality": "current",
