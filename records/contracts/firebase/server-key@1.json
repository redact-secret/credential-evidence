          "supports": "delimiter: a single : between head and body"
        }
      ]
    },
    {
      "id": "field-body-length",
      "statement": "body length: exactly 140 characters of [A-Za-z0-9_-] (140 is dominant from 2017 on (58 of 66 observed keys); late-2016 keys carry 162/167/183-character bodies and Google's 2017 blog gives a 175 total. No fixture asserts silence on those lengths.)",
      "evidenceClass": "unresolved",
      "temporality": "current",
      "observedAt": "2026-09-20",
      "sources": [
        {
          "sourceId": "github-com-projectdiscovery-nuclei-templates-cb00285b1a",
