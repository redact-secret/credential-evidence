    {
      "id": "field-head",
      "statement": "head: literal AAAA plus 7 characters (11 in total): the base64url of the 8-byte big-endian project number, so AAAA holds only while project numbers stay below 2^40",
      "evidenceClass": "unresolved",
      "temporality": "current",
      "observedAt": "2026-09-22",
      "sources": [
        {
          "sourceId": "github-com-redact-secret-redact-secret-748c13816d",
          "supports": "Head-to-project-number decoding is an aggregate empirical analysis; Google documents no AAAA prefix."
        }
      ]
    },
    {
      "id": "field-delimiter",
      "statement": "delimiter: a single : between head and body",
      "evidenceClass": "unresolved",
      "temporality": "current",
      "observedAt": "2026-09-20",
