{
  "schemaVersion": 1,
  "kind": "format-contract",
  "id": "bitwarden:secrets-manager-access-token@1",
  "family": "bitwarden:secrets-manager-access-token",
  "revision": 1,
  "period": "current",
  "validity": {
    "from": null,
    "until": null
  },
  "supersedes": null,
  "structure": {
    "descriptivePattern": "^0\\.[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\.[A-Za-z0-9]{30}:[A-Za-z0-9+/]{22}==$"
  },
  "claims": [
    {
      "id": "provider-source",
      "statement": "bitwarden/sdk-internal access_token.rs (824c1cf, last changed 2025-09-30): split once on :, the first part on . into exactly three parts, version \"0\", a UUID, and a Base64 key that decodes to 16 bytes; bitwarden/server CreateAccessTokenCommand (bb3a9da): SecureRandomString(30) with upper, lower and numeric; re-checked 2026-09-29: 0. + UUID + . + exactly 30 [A-Za-z0-9] + : + 22 standard Base64 + == (94 in all); no checksum",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-29",
      "sources": [
        {
          "sourceId": "github-com-bitwarden-sdk-internal-10010bd27f",
          "supports": "0. + UUID + . + exactly 30 [A-Za-z0-9] + : + 22 standard Base64 + == (94 in all); no checksum",
          "locator": "#L47-L85"
        }
      ]
    },
    {
      "id": "field-version",
      "statement": "version: the literal 0 followed by . (A future version is a grammar change to re-research, never a widening.)",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-29",
      "sources": [
        {
          "sourceId": "bitwarden-com-b047250b46",
          "supports": "docs example"
        },
        {
          "sourceId": "github-com-bitwarden-sdk-internal-10010bd27f",
          "supports": "version must be \"0\"",
          "locator": "#L47-L85"
        }
      ]
    },
    {
      "id": "field-token-id",
      "statement": "token-id: a UUID, 8-4-4-4-12 hex with -; lowercase as issued, uppercase accepted by the parser",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-29",
      "sources": [
        {
          "sourceId": "bitwarden-com-b047250b46",
          "supports": "docs example"
        },
        {
          "sourceId": "github-com-bitwarden-sdk-internal-10010bd27f",
          "supports": "Uuid parse",
          "locator": "#L47-L85"
        }
      ]
    },
    {
      "id": "field-client-secret",
      "statement": "client-secret: exactly 30 [A-Za-z0-9]",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-29",
      "sources": [
        {
          "sourceId": "github-com-bitwarden-server-745b4c2eb0",
          "supports": "upper, lower, numeric; special = false",
          "locator": "#L205-L209"
        },
        {
          "sourceId": "github-com-bitwarden-server-ed20d9ab64",
          "supports": "_clientSecretMaxLength = 30; SecureRandomString(30)",
          "locator": "#L14-L29"
        }
      ]
    },
    {
      "id": "field-encryption-key",
      "statement": "encryption-key: a 16-byte key as standard Base64: 22 [A-Za-z0-9+/] then == (Canonical Base64 of 16 bytes ends its 22nd character in one of A, Q, g, w; the contract keeps the handoff class, and positives are canonical encodings.)",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-29",
      "sources": [
        {
          "sourceId": "bitwarden-com-b047250b46",
          "supports": "24 characters ending =="
        },
        {
          "sourceId": "github-com-bitwarden-sdk-internal-10010bd27f",
          "supports": "decodes to 16 bytes; the test comment says the key is generated padded",
          "locator": "#L47-L85"
        }
      ]
    },
    {
      "id": "field-unpadded-key",
      "statement": "unpadded-key: the parser also accepts the key without ==, but the generator always pads (Outside the issued grammar: an unpadded twin is a one-property twin, and an unpadded copy is an accepted false negative.)",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-29",
      "sources": [
        {
          "sourceId": "github-com-bitwarden-sdk-internal-10010bd27f",
          "supports": "padding ignored on decode",
          "locator": "#L47-L85"
        },
        {
          "sourceId": "github-com-redact-secret-redact-secret-0842fd98b1",
          "supports": "excluded shapes"
        }
      ]
    },
    {
      "id": "field-boundary",
      "statement": "boundary: the byte before 0 is not [A-Za-z0-9._-] (so 10.<uuid> and v0.<uuid> are not claimed) and the byte after == is not [A-Za-z0-9+/=] (Handoff boundary decision, not a provider statement.)",
      "evidenceClass": "unresolved",
      "temporality": "current",
      "observedAt": "2026-09-29",
      "sources": [
        {
          "sourceId": "github-com-redact-secret-redact-secret-0842fd98b1",
          "supports": "implementation notes"
        }
      ]
    },
    {
      "id": "field-transport",
      "statement": "transport: the BWS_ACCESS_TOKEN environment variable, the bws CLI --access-token flag, SDK clients and CI integrations",
      "evidenceClass": "provider-documented",
