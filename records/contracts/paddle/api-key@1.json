  "claims": [
    {
      "id": "provider-source",
      "statement": "Paddle docs \"API keys\" (observed 2026-09-29): \"They're 69 characters in length and always contain five underscores. You can use regex to match API keys: ^pdl_(live|sdbx)_apikey_[a-z\\d]{26}_[a-zA-Z\\d]{22}_[a-zA-Z\\d]{3}$\"; \"API keys are case-sensitive\"; keys created before 2025-05-06 are legacy 50-character lowercase alphanumeric strings: pdl_live_apikey_ or pdl_sdbx_apikey_ + 26 [a-z0-9] + _ + 22 [A-Za-z0-9] + _ + 3 [A-Za-z0-9], 69 in all",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-29",
      "sources": [
        {
          "sourceId": "developer-paddle-com-20edbd1725",
          "supports": "pdl_live_apikey_ or pdl_sdbx_apikey_ + 26 [a-z0-9] + _ + 22 [A-Za-z0-9] + _ + 3 [A-Za-z0-9], 69 in all"
        }
      ]
    },
    {
