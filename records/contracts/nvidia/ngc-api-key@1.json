          "supports": "the same class, floor 40",
          "locator": "#L57-L60"
        }
      ]
    },
    {
      "id": "field-floor",
      "statement": "floor: at least 60 body bytes, open-ended (Provider-authored (R2), not the tool width: the SkillEvaluator rule's lower 40 is below it and contradicts nothing.)",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-29",
      "sources": [
        {
          "sourceId": "github-com-nvidia-nemo-nemo-helix-cf737a8c99",
