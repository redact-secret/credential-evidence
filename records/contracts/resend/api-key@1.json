  "structure": {
    "descriptivePattern": "^re_[A-Za-z0-9]{8}_[A-Za-z0-9]{24}$"
  },
  "claims": [
    {
      "id": "provider-source",
      "statement": "resend-cli login rejects a key that does not start with re_; the create-API-key response example is re_ + 8 + _ + 24 (re-checked 2026-09-28: 36 characters, no 0/O/I/l): re_ + 8 alphanumerics + _ + 24 alphanumerics, 36 in all; full_access and sending_access keys share the shape",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "resend-com-8fd9a2a2ab",
          "supports": "re_ + 8 alphanumerics + _ + 24 alphanumerics, 36 in all; full_access and sending_access keys share the shape"
        }
      ]
    },
    {
      "id": "field-prefix",
      "statement": "prefix: re_",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "github-com-resend-resend-cli-a396e01b85",
          "supports": "\"Your key must start with re_\"",
          "locator": "#authentication"
        }
      ]
    },
    {
      "id": "field-layout",
      "statement": "layout: re_ + 8 + _ + 24 (36 in all); the _ at offset 11 is the only one after the prefix",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "github-com-redact-secret-redact-secret-143c9ef7a8",
          "supports": "the same shape in three distinct SDK fixture values"
        },
        {
          "sourceId": "github-com-redact-secret-redact-secret-ac559a3b98",
          "supports": "R5",
          "locator": "#issuecomment-5871306275"
        },
        {
          "sourceId": "resend-com-8fd9a2a2ab",
          "supports": "response example, measured by script, no value retained"
        }
      ]
    },
    {
      "id": "field-alphabet",
      "statement": "alphabet: [A-Za-z0-9] in both segments (Every provider example is alphanumeric and base58-consistent; the contract keeps the alphanumeric superset, so a key with 0, O, I or l is not a false negative.)",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "github-com-redact-secret-redact-secret-143c9ef7a8",
          "supports": "a trufflehog rule newer than the pinned 3.97.4 uses base58, a narrower class"
        },
        {
          "sourceId": "resend-com-8fd9a2a2ab",
          "supports": "alphabet: [A-Za-z0-9] in both segments"
        }
      ]
    },
    {
      "id": "field-mixed-case-guard",
      "statement": "mixed-case-guard: the product requires at least one upper- and one lower-case letter in the 32 body bytes (Project false-positive policy, not a provider fact. Positives are mixed case; no fixture asserts silence on a random one-case body, and the one-case controls are word-built identifiers.)",
      "evidenceClass": "unresolved",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "github-com-redact-secret-redact-secret-143c9ef7a8",
          "supports": "the short-prefix guard; false-negative cost about 6e-8"
        }
      ]
    },
    {
      "id": "field-transport",
      "statement": "transport: the RESEND_API_KEY environment variable, sent as Authorization: Bearer",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "resend-com-6fa3a03170",
