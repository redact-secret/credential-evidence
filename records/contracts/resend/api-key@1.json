          "locator": "#authentication"
        }
      ]
    },
    {
      "id": "field-webhook-secret",
      "statement": "webhook-secret: whsec_ webhook signing secrets use the Svix scheme (Another credential class: a prefix twin, never a benign control.)",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
