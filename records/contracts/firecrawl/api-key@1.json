        }
      ]
    },
    {
      "id": "field-legacy-keys",
      "statement": "legacy-keys: bare dashed UUID keys from before 2024-04-16 are still accepted by parseApi (Not attributable to Firecrawl: excluded, and never a benign control either (a dashed UUID is authored only as a request id).)",
      "evidenceClass": "provider-documented",
      "temporality": "current",
