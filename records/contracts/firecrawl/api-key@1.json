  "structure": {
    "descriptivePattern": "^fc-[0-9a-f]{12}4[0-9a-f]{3}[89ab][0-9a-f]{15}$"
  },
  "claims": [
    {
      "id": "provider-source",
      "statement": "parseApi.ts strips fc- and re-inserts the 8-4-4-4-12 dashes (last changed 2026-05-15, re-checked 2026-09-28); api_keys.key is uuid().defaultRandom(): the docs and SDK document the fc- prefix; provider server code (ruling R1) makes the body a dashless lowercase random UUIDv4 (32 hex, version nibble 4, variant 8/9/a/b), 35 in all",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "github-com-firecrawl-firecrawl-d9b255c69a",
          "supports": "the docs and SDK document the fc- prefix; provider server code (ruling R1) makes the body a dashless lowercase random UUIDv4 (32 hex, version nibble 4, variant 8/9/a/b), 35 in all"
        }
      ]
    },
    {
      "id": "field-prefix",
      "statement": "prefix: fc-",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "docs-firecrawl-dev-f34bd42c06",
          "supports": "prefix: fc-"
        },
        {
          "sourceId": "github-com-firecrawl-firecrawl-af437e3661",
          "supports": "startsWith('fc-')",
          "locator": "#L154"
        }
      ]
    },
    {
      "id": "field-body",
      "statement": "body: exactly 32 lowercase hex: a dashless UUID",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "github-com-firecrawl-firecrawl-cf146f8a99",
          "supports": "uuid(\"key\").defaultRandom()",
          "locator": "#L68-L72"
        },
        {
          "sourceId": "github-com-firecrawl-firecrawl-d9b255c69a",
          "supports": "body: exactly 32 lowercase hex: a dashless UUID"
        },
        {
          "sourceId": "github-com-redact-secret-redact-secret-ac559a3b98",
          "supports": "R1",
          "locator": "#issuecomment-5852413851"
        }
      ]
    },
    {
      "id": "field-uuid-v4-nibbles",
      "statement": "uuid-v4-nibbles: body byte 12 is 4 and body byte 16 is one of 8 9 a b (The validator would accept versions 1–8; issued keys are v4, so other nibbles back twins.)",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "github-com-firecrawl-firecrawl-0e36f901ab",
          "supports": "UUID_RE",
          "locator": "#L757-L795"
        },
        {
          "sourceId": "github-com-firecrawl-firecrawl-cf146f8a99",
          "supports": "a Postgres random UUIDv4",
          "locator": "#L68-L72"
        }
      ]
    },
    {
      "id": "field-separators",
      "statement": "separators: none after the prefix; no checksum",
      "evidenceClass": "provider-documented",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
        {
          "sourceId": "github-com-firecrawl-firecrawl-d9b255c69a",
          "supports": "separators: none after the prefix; no checksum"
        }
      ]
    },
    {
      "id": "field-boundary",
      "statement": "boundary: a key glued to an identifier on either side ([A-Za-z0-9_-]) is not claimed; CSS and calendar classes such as fc-daygrid-day are glued or fail the body",
      "evidenceClass": "unresolved",
      "temporality": "current",
      "observedAt": "2026-09-28",
      "sources": [
