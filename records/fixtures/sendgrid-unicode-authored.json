{
  "schemaVersion": 1,
  "kind": "fixture-set",
  "id": "sendgrid-unicode-authored",
  "title": "Unicode invisibles and byte-boundary inputs around a SendGrid-shaped key (authored)",
  "description": "Five authored base samples (two synthetic keys, three benign texts) and hand-written projections of them: inserted and adjacent zero-width, BOM, NBSP and emoji code points, normalization-dependent variants left unresolved, valid UTF-8 byte chunking inside multibyte sequences, and expected rejections (invalid UTF-8, UTF-16 pair split). Every key is built from the words SYNTHETIC, EXAMPLE and zeros in the documented 69-character grammar; none was issued, none was tested against any service. Projections of one base are correlated, not independent samples.",
  "origin": {
    "type": "authored-cases"
  },
  "generated": false,
