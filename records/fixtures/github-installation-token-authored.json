  "evidence": {
    "ev-stateless-shape": {
      "basis": "provider-documented",
      "rationale": "GitHub writes the stateless form ghs_APPID_JWT, says it has two dots and about 520 characters, and recommends an expression that matches it. The expectation covers this lexical shape only; a syntactically formed JWT is not evidence that a value was issued, and this value was never issued.",
      "sources": [
        {
          "sourceId": "github-blog-dd07252324",
          "supports": "Token format changes to ghs_APPID_JWT; length about 520 characters.",
          "locator": "What is changing?"
        },
        {
          "sourceId": "github-blog-30e232220c",
          "supports": "A stateless token is a ghs_-prefixed JWT with two dots; recommended expression ghs_[A-Za-z0-9\\.\\-_]{36,}.",
          "locator": "How to use it"
        }
      ],
      "observedAt": "2026-10-03"
    },
    "ev-opaque-shape": {
      "basis": "provider-documented",
      "rationale": "GitHub describes the previous installation token as 40 characters (ghs_ plus 36) and as an opaque string with no dots, and its recommended expression covers it. Lexical shape only; the value was never issued.",
      "sources": [
        {
          "sourceId": "github-blog-dd07252324",
          "supports": "Applications that rely on installation tokens being exactly 40 characters long may not handle the new format.",
          "locator": "Opening paragraph"
        },
        {
          "sourceId": "github-blog-30e232220c",
          "supports": "A stateful token is a short opaque string with no dots.",
          "locator": "How to use it"
        }
      ],
      "observedAt": "2026-10-03"
    },
    "ev-open-grammar": {
      "basis": "unresolved",
      "rationale": "The recommended expression matches the value, but the provider documents neither the APPID segment's grammar nor whether a token may lack it, and describes only two-dot (stateless) and no-dot (opaque) tokens; the expected outcome is not settled.",
      "sources": [
        {
          "sourceId": "github-blog-dd07252324",
          "supports": "ghs_APPID_JWT notation with no grammar for APPID; JWT contents are not for clients to depend on.",
          "locator": "What is changing?"
        },
        {
          "sourceId": "github-blog-30e232220c",
          "supports": "Recommended expression and the two-dot / no-dot rule.",
          "locator": "How to use it; Verifying the token type"
        }
      ],
      "observedAt": "2026-10-03"
    },
    "ev-policy-near-miss": {
      "basis": "project-policy",
      "rationale": "Below both the provider's documented minimum of 36 characters after the prefix and the 40-character total, so not a token of the documented grammar. A project decision pending a maintainer and a reviewer who is not the author; not a provider rule.",
      "sources": [],
      "observedAt": "2026-10-03"
    },
    "ev-policy-prose": {
      "basis": "project-policy",
      "rationale": "Text that names the notation or the header holds no credential value. A project decision pending a maintainer and a reviewer who is not the author; not a provider rule.",
      "sources": [],
      "observedAt": "2026-10-03"
    },
    "ev-policy-ids": {
      "basis": "project-policy",
      "rationale": "Numeric app and installation identifiers are not credentials. A project decision pending a maintainer and a reviewer who is not the author; the provider sources read here do not classify them.",
      "sources": [],
      "observedAt": "2026-10-03"
    },
    "ev-open-attribution": {
      "basis": "unresolved",
      "rationale": "A JWT without the ghs_ prefix is not an installation token (the prefix names the kind), but whether and as what it is reported belongs to the generic JWT family's own reviewed expectations; no outcome is asserted here.",
      "sources": [
        {
          "sourceId": "github-blog-30e232220c",
          "supports": "Installation tokens are ghs_-prefixed; the JWT form is recognised by the dots after that prefix.",
          "locator": "Verifying the token type"
        }
