    "shape": [
      {
        "id": "prefix-and-body",
        "text": "A token of this type begins dp.st., followed by a body of 40 to 44 letters and digits, with no separator inside the body and no checksum documented. Every documented example and the one observed token have a 43-character body; the documented band is the contract.",
        "evidenceClass": "provider-documented",
        "temporality": "current",
        "observedAt": "2026-09-28",
        "citations": [
          {
            "kind": "claim",
            "claimId": "provider-source"
          },
          {
            "kind": "claim",
            "claimId": "field-prefix"
          },
          {
            "kind": "claim",
            "claimId": "field-body"
          },
          {
            "kind": "claim",
            "claimId": "field-separators"
          },
          {
            "kind": "source",
            "sourceId": "docs-doppler-com-7a28d9952f"
          }
        ]
      },
      {
        "id": "environment-segment",
        "text": "An optional environment segment of 2 to 35 characters (lowercase letters, digits, underscore and hyphen) followed by a dot may sit between the prefix and the body. This is the only one of the seven types that has such a segment.",
        "evidenceClass": "provider-documented",
        "temporality": "current",
