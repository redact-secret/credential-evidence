          }
        ]
      },
      {
        "id": "example-value-placeholder",
        "text": "The example secret in AWS documentation is a published placeholder and not a credential.",
        "evidenceClass": "provider-documented",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "citations": [
          {
            "kind": "claim",
