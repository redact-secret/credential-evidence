          }
        ]
      },
      {
        "id": "one-char-longer-example",
        "text": "The AssumeRole and GetSessionToken sample responses show a secret one character longer than 40. No reviewed source treats that as a different format; it reads as a documentation slip.",
        "evidenceClass": "provider-documented",
        "temporality": "current",
        "observedAt": "2026-09-29",
