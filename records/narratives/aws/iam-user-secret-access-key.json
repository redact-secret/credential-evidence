          }
        ]
      }
    ],
    "openQuestions": [
      {
        "id": "secret-not-forty",
        "text": "Do the two keys of an IAM user, or a temporary credential, ever show a secret that is not 40 characters? No source reports one.",
        "evidenceClass": "unresolved",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "unresolved": {
          "reviewEvent": 3,
          "reason": "No reviewed source reports a secret of another length, and none states that all issued secrets are 40 characters."
        }
      }
    ]
