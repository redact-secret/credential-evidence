  "sections": {
    "shape": [
      {
        "id": "abia-key-id",
        "text": "AWS documents that the access key ID inside an STS service bearer token begins with ABIA. It does not describe the bearer token string itself.",
        "evidenceClass": "provider-documented",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "citations": [
          {
            "kind": "source",
            "sourceId": "docs-aws-amazon-com-d8bc0c362f"
          },
          {
            "kind": "source",
            "sourceId": "docs-aws-amazon-com-59c608844f",
            "locator": "#identifiers-prefixes"
          }
        ]
      },
      {
        "id": "token-type-string",
        "text": "The CodeArtifact API types the returned authorization token only as a string, with no length, alphabet or prefix, and states a life between 15 minutes and 12 hours.",
        "evidenceClass": "provider-documented",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "citations": [
          {
            "kind": "source",
            "sourceId": "docs-aws-amazon-com-8f86716297"
          },
          {
            "kind": "source",
            "sourceId": "docs-aws-amazon-com-dfff72ece4"
          }
        ]
      }
    ],
    "issuance": [
      {
        "id": "services-call-get-token",
        "text": "Services such as CodeArtifact (and, by the same permission, ECR Public) call the sts:GetServiceBearerToken operation and hand the token back to the caller.",
        "evidenceClass": "provider-documented",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "citations": [
