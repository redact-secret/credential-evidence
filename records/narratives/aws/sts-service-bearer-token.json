    "collisions": [
      {
        "id": "bare-abia-id",
        "text": "A bare ABIA value that turns up in text is an identifier shaped like the other key IDs, not a bearer token, and belongs with the key-ID layout. Scanner rules that mention ABIA list it only as an access-key-ID prefix.",
        "evidenceClass": "tool-corroborated",
