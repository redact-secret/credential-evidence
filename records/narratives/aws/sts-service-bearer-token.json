        "unresolved": {
          "reviewEvent": 2,
          "reason": "Searches of AWS documentation, SDK and CLI source, blogs, forum threads and code search found the ABIA prefix and the permission only; none states the token's shape. Reddit and Stack Overflow pages could not be read."
        }
