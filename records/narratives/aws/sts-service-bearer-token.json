    "openQuestions": [
      {
        "id": "token-format-documented",
        "text": "Does AWS document the format of the CodeArtifact or ECR Public bearer token, or has anyone published a decoded structure? Nothing reviewed does, so the family has no grammar for the value that actually authenticates.",
        "evidenceClass": "unresolved",
        "temporality": "current",
