    "openQuestions": [
      {
        "id": "admin-body-grammar",
        "text": "Is the admin key body always 93 characters plus AA, and does an admin02 version exist?",
        "evidenceClass": "unresolved",
        "temporality": "current",
        "observedAt": "2026-09-27",
        "unresolved": {
          "reviewEvent": 2,
          "reason": "Anthropic's text states neither the always-93-plus-AA body nor a second version; confirming it needs a second key issued with a different expiry."
        }
      },
      {
        "id": "admin-version",
        "text": "Is sk-ant-admin- without a version segment a real spelling, and is there a version other than admin01?",
        "evidenceClass": "unresolved",
