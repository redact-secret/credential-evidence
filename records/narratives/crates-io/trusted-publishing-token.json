  "sections": {
    "shape": [
      {
        "id": "grammar",
        "text": "A trusted-publishing token is the literal prefix cio_tp_ followed by exactly 32 letters and digits, 39 characters in all. The registry's server code defines the prefix and generates 31 random alphanumerics, then one check character; its parser requires exactly 32 characters after the prefix.",
        "evidenceClass": "provider-documented",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "citations": [
          {
            "kind": "claim",
            "claimId": "provider-source"
          },
          {
            "kind": "claim",
            "claimId": "field-prefix"
          },
          {
            "kind": "claim",
            "claimId": "field-body"
          },
          {
            "kind": "source",
            "sourceId": "github-com-rust-lang-crates-io-72a03988b4"
          }
        ]
      },
      {
        "id": "check-character",
        "text": "The 32nd body character is a check character drawn from letters and digits: the XOR of the 31 raw bytes, modulo 62.",
        "evidenceClass": "provider-documented",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "citations": [
          {
            "kind": "claim",
            "claimId": "field-checksum"
          },
          {
            "kind": "source",
            "sourceId": "github-com-rust-lang-crates-io-72a03988b4"
          }
        ]
      },
      {
        "id": "check-never-rejects",
        "text": "The check character corroborates a match but does not by itself reject a value that otherwise has the right shape.",
        "evidenceClass": "unresolved",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "leads": [
          {
            "kind": "claim",
            "claimId": "field-policy-checksum"
          }
        ],
        "unresolved": {
          "reviewEvent": 2,
          "reason": "A handling choice, not a provider fact: the registry code read does not say whether a mismatching check character is rejected on the server side."
        }
      }
    ],
    "issuance": [
