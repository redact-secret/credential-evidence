  "sections": {
    "shape": [
      {
        "id": "prefix-body",
        "text": "An OAuth client secret is GOCSPX- followed by exactly 28 characters of letters, digits, underscore and hyphen, 35 characters in all. Google's own open-source scanner rule (narrowed to exactly 28 by a Google engineer on 2025-12-03) and two third-party rules agree, giving three dated references from three owners.",
        "evidenceClass": "tool-corroborated",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "citations": [
          {
            "kind": "claim",
            "claimId": "tool-corroboration"
          },
          {
            "kind": "claim",
            "claimId": "field-prefix"
          },
          {
            "kind": "claim",
            "claimId": "field-body"
          },
          {
            "kind": "source",
            "sourceId": "github-com-google-osv-scalibr-929e852d03",
            "locator": "#L51-L58"
          },
          {
            "kind": "source",
            "sourceId": "github-com-praetorian-inc-noseyparker-22b9fd9a79",
            "locator": "#L17-L29"
          },
          {
            "kind": "source",
            "sourceId": "github-com-samsung-credsweeper-da6c4ccf00",
            "locator": "#L463-L475"
          }
        ]
      },
      {
        "id": "boundary",
        "text": "Two of the rules require that no letter, digit, underscore or hyphen touch the value on either side.",
        "evidenceClass": "tool-corroborated",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "citations": [
          {
            "kind": "claim",
            "claimId": "field-boundary"
          }
        ]
      },
      {
        "id": "no-documented-format",
        "text": "Is the GOCSPX- grammar stated in any page authored by Google for developers?",
        "evidenceClass": "unresolved",
        "temporality": "current",
        "observedAt": "2026-09-29",
        "leads": [
          {
            "kind": "source",
            "sourceId": "github-com-google-osv-scalibr-929e852d03",
            "locator": "#L51-L58"
          }
        ],
        "unresolved": {
          "reviewEvent": 2,
          "reason": "Google documents no format for client secrets; the evidence is one Google-authored rule and two third-party rules, which do not count as a provider document."
        }
