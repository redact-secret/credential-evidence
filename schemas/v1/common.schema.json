{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:credential-evidence:schema:v1:common",
  "title": "Shared definitions for credential-evidence v1 records",
  "description": "Only $defs live here. Every entity schema references these so ID, date and link rules are defined exactly once.",
  "x-schemaRevision": "1.0.0",
  "$defs": {
    "slug": {
      "description": "Lowercase ASCII words joined by single hyphens. No dates, versions or scanner names unless intrinsic to the entity.",
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "providerId": {
      "description": "A slug. The reserved id 'generic' holds families that have no single issuing provider.",
      "$ref": "#/$defs/slug"
    },
    "familyId": {
      "description": "<providerId>:<family-slug>. Identity is independent of any scanner, detector or contract revision.",
      "type": "string",
      "maxLength": 193,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "contractId": {
      "description": "<familyId>@<revision>, revision a positive integer. Each revision is an immutable record.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*@[1-9][0-9]{0,5}$"
    },
    "fixtureId": {
      "description": "<collection-slug>--<name-slug>; the legacy fixture slug form is preserved verbatim.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*--[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "description": "Calendar date YYYY-MM-DD (UTC).",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "dateOrDateTime": {
      "description": "YYYY-MM-DD or an RFC 3339 UTC timestamp ending in Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z)?$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidenceClass": {
      "description": "How well a claim is supported. Evidence descriptors only; never a product support status.",
      "enum": ["provider-documented", "tool-corroborated", "project-policy", "unresolved"]
    },
    "expectationOutcome": {
      "description": "Scanner-neutral semantic outcome.",
      "enum": ["must-flag", "must-not-flag", "may-flag", "not-assertable"]
    },
    "lifecycle": {
      "description": "Lifecycle of the evidence record itself.",
      "enum": ["draft", "reviewed", "deprecated", "withdrawn"]
    },
    "externalRefs": {
      "description": "Optional pointers into other systems (scanners, products, trackers). Purely informational; never part of identity and never consulted to interpret the record. This is the only place a detector or product identifier may appear.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "id"],
        "properties": {
          "system": { "$ref": "#/$defs/slug" },
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "url": { "$ref": "#/$defs/httpsUrl" },
          "note": { "$ref": "#/$defs/text" }
        }
      }
    },
    "pinnedLink": {
      "description": "A link to a past state. GitHub blob/tree/raw links must use a 40-hex commit, never a branch.",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "pin"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "pin": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "commit"],
              "properties": { "kind": { "const": "commit-permalink" }, "commit": { "$ref": "#/$defs/gitCommit" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "archiveUrl"],
              "properties": {
                "kind": { "const": "archive-snapshot" },
                "archiveUrl": { "$ref": "#/$defs/httpsUrl" },
                "capturedAt": { "$ref": "#/$defs/dateOrDateTime" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "sha256"],
              "properties": { "kind": { "const": "content-digest" }, "sha256": { "$ref": "#/$defs/sha256" } }
            },
            {
              "description": "Live content that can change. Allowed only for current-state facts, never for historical ones.",
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "live-unpinned" } }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "url": { "pattern": "^https://(github\\.com/[^/\\s]+/[^/\\s]+/(blob|tree|raw)/|raw\\.githubusercontent\\.com/)" } } },
          "then": { "properties": { "pin": { "properties": { "kind": { "enum": ["commit-permalink", "archive-snapshot", "content-digest"] } } } } }
        }
      ]
    },
    "sourceRef": {
      "description": "A claim-level citation of an evidence-source record.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "supports"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/slug" },
        "supports": { "description": "The exact claim this source is cited for.", "$ref": "#/$defs/text" },
        "locator": { "description": "Section, anchor, line or page inside the source.", "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "sourceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceRef" }
    },
    "supportedClaim": {
      "description": "A claim plus how it is supported. Provider-documented and tool-corroborated claims must cite at least one source; observedAt is when a person or tool last confirmed the claim against those sources.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidenceClass", "temporality", "observedAt", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "statement": { "$ref": "#/$defs/text" },
        "evidenceClass": { "$ref": "#/$defs/evidenceClass" },
        "temporality": { "description": "current: believed to hold today. historical: held for a past period; the period is given on the owning record.", "enum": ["current", "historical"] },
        "observedAt": { "$ref": "#/$defs/dateOrDateTime" },
        "sources": { "$ref": "#/$defs/sourceRefs" }
      },
      "if": { "properties": { "evidenceClass": { "enum": ["provider-documented", "tool-corroborated"] } } },
      "then": { "properties": { "sources": { "minItems": 1 } } }
    },
    "validityPeriod": {
      "description": "When a format was in effect at the provider. Null means unknown or unbounded, never 'today'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "until"],
      "properties": {
        "from": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "until": { "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "approximate": { "type": "boolean" }
      }
    }
  }
}
