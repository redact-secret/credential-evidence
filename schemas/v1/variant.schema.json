{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:credential-evidence:schema:v1:variant",
  "title": "Variant and history",
  "description": "A named variant of a credential family (a historical form, a regional form, a rotated format) with an append-only change history. A variant may belong to one contract revision; the contract chain records how the family's grammar moved, the variant records the named forms and when they appeared or ended.",
  "x-schemaRevision": "1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "family", "name", "variantType", "description", "effective", "history", "lifecycle"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "variant" },
    "id": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
    "family": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/familyId" },
    "contract": {
      "oneOf": [{ "$ref": "urn:credential-evidence:schema:v1:common#/$defs/contractId" }, { "type": "null" }]
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "variantType": { "enum": ["format-revision", "historical-form", "regional-form", "encoding-form", "deprecated-form", "other"] },
    "description": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" },
    "effective": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/validityPeriod" },
    "replaces": {
      "description": "Variant this one replaced, when the change is a succession.",
      "oneOf": [{ "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" }, { "type": "null" }]
    },
    "history": {
      "description": "Append-only. Corrections add an entry; they never edit or delete an earlier one.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observedAt", "change", "note", "sources"],
        "properties": {
          "observedAt": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/dateOrDateTime" },
          "occurredAt": {
            "description": "When the change happened at the provider, if known; distinct from when it was observed.",
            "oneOf": [{ "$ref": "urn:credential-evidence:schema:v1:common#/$defs/date" }, { "type": "null" }]
          },
          "change": { "enum": ["introduced", "revised", "deprecated", "retired", "corrected"] },
          "note": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" },
          "sources": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/sourceRefs" }
        }
      }
    },
    "lifecycle": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/lifecycle" },
    "externalRefs": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/externalRefs" },
    "notes": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" }
  }
}
