{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:credential-evidence:schema:v1:format-contract",
  "title": "Format contract",
  "description": "What can be stated from evidence about one credential family's format during one period. A family may have many contracts over time (@1, @2, ...). A published revision is immutable: a changed understanding is a new revision that supersedes the old one. Contracts describe facts and carry no detection code.",
  "x-schemaRevision": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "family", "revision", "period", "validity", "supersedes", "structure", "claims", "lifecycle"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "format-contract" },
    "id": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/contractId" },
    "family": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/familyId" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 999999 },
    "period": {
      "description": "current: describes present issuance. historical: no longer issued but tokens may persist. proposed: under research, not yet established.",
      "enum": ["current", "historical", "proposed"]
    },
    "validity": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/validityPeriod" },
    "supersedes": {
      "description": "The revision this one replaces, or null for the first.",
      "oneOf": [{ "$ref": "urn:credential-evidence:schema:v1:common#/$defs/contractId" }, { "type": "null" }]
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "alphabet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "enum": ["hex-lower", "hex-upper", "base32", "base58", "base62", "base64", "base64url", "digits", "upper-alnum", "lower-alnum", "mixed", "other"] },
            "characters": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "length": {
          "description": "Length in characters of the credential body as defined by the provider.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exact": { "type": "integer", "minimum": 1 },
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          }
        },
        "separators": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 8 } },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role"],
            "properties": {
              "name": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
              "role": { "enum": ["prefix", "body", "separator", "checksum", "version", "suffix", "companion", "other"] },
              "description": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" }
            }
          }
        },
        "descriptivePattern": {
          "description": "Optional ECMAScript-syntax regular expression that documents the grammar for readers. It is descriptive, not a detector.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "checksum": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" }
      }
    },
    "claims": {
      "description": "Every source-backed statement in the contract, each with its own evidence class, temporality and observed-at.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/supportedClaim" }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "raisedAt"],
        "properties": {
          "id": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
          "question": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" },
          "raisedAt": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/date" }
        }
      }
    },
    "lifecycle": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/lifecycle" },
    "externalRefs": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/externalRefs" },
    "notes": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycle": { "enum": ["reviewed"] } } },
      "then": { "properties": { "claims": { "minItems": 1 } } }
    }
  ]
}
