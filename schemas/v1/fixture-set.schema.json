{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:credential-evidence:schema:v1:fixture-set",
  "title": "Fixture set (sharded fixture projections)",
  "description": "A compact shard of executable fixture projections that share one origin: either hand-written fixtures, or the recorded output of one documented generation rule. Each item projects exactly one Case, or exactly one cell (fixture plan, scenario, families) of a matrix projection (schema revision 1.3.0, ADR 0008), and carries its own expected outcome, spans and evidence entry; the set is derived, never the canonical human record. Sets are organised by family provider, never by legacy suite. Content is embedded as text next to its sha256 because the synthetic inputs are small and one file per fixture would not scale (ADR 0005). Added in schema revision 1.1.0.",
  "x-schemaRevision": "1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "title", "origin", "generated", "fixtures", "lifecycle"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "fixture-set" },
    "id": { "description": "The collection slug (a provider or a neutral grouping, never a legacy suite): every fixture id in the set is <id>--<name>.", "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "authored-cases" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "rule", "generator"],
          "properties": {
            "type": { "const": "generation-rule" },
            "rule": { "description": "Slug naming the generation rule; the set's cases are its inputs.", "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
            "generator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version", "sourceRevision", "entrypoint"],
              "properties": {
                "name": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
                "version": { "type": "string", "minLength": 1, "maxLength": 64 },
                "sourceRevision": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/gitCommit" },
                "entrypoint": { "description": "Path of the generator source inside the generator's repository at sourceRevision.", "type": "string", "minLength": 1, "maxLength": 300 }
              }
            },
            "seed": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      ]
    },
    "generated": { "type": "boolean" },
    "evidence": {
      "description": "The evidence entries the set's fixtures cite, by key (schema revision 1.3.0). An evidence entry is the basis, reason and sources for one or more fixtures: the legacy evidence tier, re-expressed as a canonical basis, lives here and on the fixture, never in a Case or Scenario id (ADR 0007 section 2). Entries are shared between fixtures, so the map is compact.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["basis", "rationale", "sources", "observedAt"],
        "properties": {
          "basis": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/evidenceClass" },
          "rationale": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" },
          "sources": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/sourceRefs" },
          "observedAt": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/dateOrDateTime" }
        },
        "if": { "properties": { "basis": { "enum": ["provider-documented", "tool-corroborated"] } } },
        "then": { "properties": { "sources": { "minItems": 1 } } }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "text", "expected"],
        "oneOf": [{ "required": ["case"], "not": { "required": ["cell"] } }, { "required": ["cell"], "not": { "required": ["case"] } }],
        "properties": {
          "id": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/fixtureId" },
          "case": { "description": "The Case this fixture projects. Exactly one of case and cell is given.", "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
          "cell": {
            "description": "The matrix cell this fixture projects (schema revision 1.3.0): a fixture plan, one of its scenario targets, and the families the value is an instance for. The reasoning lives in the scenario; the plan declares the matrix.",
            "type": "object",
            "additionalProperties": false,
            "required": ["plan", "scenario", "families"],
            "properties": {
              "plan": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
              "scenario": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
              "families": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/familyId" } }
            }
          },
          "evidence": { "description": "Key of this fixture's entry in the set's evidence map. When absent, the fixture carries its target's evidence (a Case's expectation, a Scenario's evidenceBasis).", "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
          "incidents": {
            "description": "Historical incidents this fixture guards against (schema revision 1.3.0); the same shape as a Case's incidents. A Case keeps its own incidents; a matrix cell has no record of its own to hold them.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "failureMode", "summary", "observedAt"],
              "properties": {
                "id": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
                "failureMode": { "enum": ["false-alarm", "missed-credential", "partial-coverage"] },
                "summary": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" },
                "observedAt": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/dateOrDateTime" },
                "externalRefs": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/externalRefs" }
              }
            }
          },
          "path": {
            "description": "Relative path the fixture is materialized at, below the set id; no absolute paths, no . or .. segments.",
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[A-Za-z0-9._/-]+$",
            "not": { "pattern": "^/|(^|/)\\.\\.?(/|$)|//" }
          },
          "context": { "description": "Carrier form, for example env, header, structured-file.", "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
          "lineage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "of"],
            "properties": {
              "relation": { "enum": ["twin-of", "mutation-of", "metamorphic-of"] },
              "of": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/fixtureId" },
              "mutationKind": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/slug" },
              "mutation": { "description": "What exactly was changed, in words.", "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" }
            }
          },
          "sha256": { "description": "SHA-256 of the UTF-8 bytes of text.", "$ref": "urn:credential-evidence:schema:v1:common#/$defs/sha256" },
          "text": { "description": "The exact fixture content.", "type": "string" },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "spans"],
            "properties": {
              "outcome": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/expectationOutcome" },
              "spans": { "type": "array", "items": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/expectedSpan" } }
            },
            "if": { "properties": { "outcome": { "enum": ["must-not-flag", "not-assertable"] } } },
            "then": { "properties": { "spans": { "maxItems": 0 } } }
          }
        }
      }
    },
    "imported": {
      "description": "Migration provenance for a set that mirrors exactly one legacy corpus. Sets organised by provider (stage B of issue 12) do not use it: their legacy coordinates are in migration/legacy-map.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "path", "legacyId"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "revision": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/gitCommit" },
        "path": { "type": "string", "minLength": 1, "maxLength": 300 },
        "legacyId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "lifecycle": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/lifecycle" },
    "externalRefs": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/externalRefs" },
    "notes": { "$ref": "urn:credential-evidence:schema:v1:common#/$defs/text" }
  },
  "allOf": [
    {
      "if": { "properties": { "origin": { "properties": { "type": { "const": "generation-rule" } }, "required": ["type"] } } },
      "then": { "properties": { "generated": { "const": true } } },
      "else": { "properties": { "generated": { "const": false } } }
    }
  ]
}
