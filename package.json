{
  "name": "credential-evidence",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical, tool-neutral credential knowledge and evidence: schemas, records and validation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "lint:identity": "node scripts/lint-identity.mjs",
    "lint:narrative": "node scripts/lint-narrative.mjs",
    "lint:skills": "node scripts/lint-skills.mjs",
    "lint:source-revision": "node scripts/lint-source-revision.mjs",
    "coverage:gaps": "node scripts/coverage-gaps.mjs",
    "source:observe": "node scripts/source-observe.mjs",
    "tidy:scan": "node scripts/tidy-scan.mjs",
    "review:check": "node scripts/review-check.mjs",
    "research:run": "node scripts/research-run.mjs",
    "record:new": "node scripts/record-new.mjs",
    "record:check": "node scripts/record-check.mjs",
    "report:bases": "node scripts/report-bases.mjs",
    "baseline:check": "node scripts/baseline.mjs check",
    "baseline:amend": "node scripts/baseline.mjs amend",
    "migrate:check": "npm run migrate:taxonomy:check && npm run migrate:cases:check && npm run migrate:narratives:check",
    "migrate:taxonomy": "node scripts/migrate/import-taxonomy.mjs",
    "migrate:taxonomy:check": "node scripts/migrate/import-taxonomy.mjs --check",
    "migrate:cases": "node scripts/migrate/import-cases.mjs",
    "migrate:cases:check": "node scripts/migrate/import-cases.mjs --check",
    "migrate:narratives": "node scripts/migrate/import-narratives.mjs",
    "migrate:narratives:check": "node scripts/migrate/import-narratives.mjs --check",
    "fixtures:materialize": "node scripts/materialize-fixtures.mjs",
    "fixtures:materialize:check": "node scripts/materialize-fixtures.mjs --check",
    "export:legacy": "node scripts/export/legacy-projection.mjs",
    "export:legacy:check": "node scripts/export/legacy-projection.mjs --check",
    "parity": "node scripts/parity/run.mjs",
    "parity:check": "node scripts/parity/run.mjs --check",
    "dual-run": "node scripts/dual-run/dual-run.mjs",
    "historical:scope": "node scripts/historical-scope.mjs",
    "historical:check": "npm run baseline:check && npm run migrate:check && npm run export:legacy:check && npm run parity:check && npm run test:historical",
    "release:check": "node scripts/release/build.mjs --check",
    "release:bundle": "node scripts/release/build.mjs",
    "release:verify": "node scripts/release/build.mjs --verify",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:historical": "node --test \"tests/historical/*.test.mjs\"",
    "check": "npm run validate && npm run lint:identity && npm run lint:narrative && npm run lint:skills && npm run lint:source-revision && npm run baseline:check && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
