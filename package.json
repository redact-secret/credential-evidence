{
  "name": "credential-evidence",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical, tool-neutral credential knowledge and evidence: schemas, records and validation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "lint:identity": "node scripts/lint-identity.mjs",
    "lint:narrative": "node scripts/lint-narrative.mjs",
    "lint:skills": "node scripts/lint-skills.mjs",
    "migrate:check": "npm run migrate:taxonomy:check && npm run migrate:cases:check && npm run migrate:narratives:check",
    "migrate:taxonomy": "node scripts/migrate/import-taxonomy.mjs",
    "migrate:taxonomy:check": "node scripts/migrate/import-taxonomy.mjs --check",
    "migrate:cases": "node scripts/migrate/import-cases.mjs",
    "migrate:cases:check": "node scripts/migrate/import-cases.mjs --check",
    "migrate:narratives": "node scripts/migrate/import-narratives.mjs",
    "migrate:narratives:check": "node scripts/migrate/import-narratives.mjs --check",
    "fixtures:materialize": "node scripts/materialize-fixtures.mjs",
    "fixtures:materialize:check": "node scripts/materialize-fixtures.mjs --check",
    "export:legacy": "node scripts/export/legacy-projection.mjs",
    "export:legacy:check": "node scripts/export/legacy-projection.mjs --check",
    "parity": "node scripts/parity/run.mjs",
    "parity:check": "node scripts/parity/run.mjs --check",
    "dual-run": "node scripts/dual-run/dual-run.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run validate && npm run lint:identity && npm run lint:narrative && npm run lint:skills && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
